// ── PORTFOLIO DAILY P&L (IBKR only — DBG fully liquidated, dbg_day_pl hardcoded 0) ─
// AMZN/MSFT/NVDA/SHIP/NOW/QBTS request.security calls removed 2026-08-18 — they
// were only ever summed into dbg_day_pl, which is now a hardcoded 0.0 constant.
// ORCL kept (still open at IBKR).
orcl_d = request.security("ORCL",  "D", close - close[1])
rxt_d  = request.security("RXT",   "D", close - close[1])
hpe_d  = request.security("HPE",   "D", close - close[1])
glw_d  = request.security("GLW",   "D", close - close[1])
mu_d   = request.security("MU",    "D", close - close[1])
ewy_d  = request.security("EWY",   "D", close - close[1])
fps_d  = request.security("FPS",   "D", close - close[1])
ichr_d = request.security("ICHR",  "D", close - close[1])
snex_d = request.security("SNEX",  "D", close - close[1])
dlth_d = request.security("DLTH",  "D", close - close[1])
lite_d = request.security("LITE",  "D", close - close[1])
avgo_d = request.security("AVGO",  "D", close - close[1])
btsg_d = request.security("BTSG",  "D", close - close[1])
goog_d = request.security("GOOG",  "D", close - close[1])
intc_d = request.security("INTC",  "D", close - close[1])
iot_d  = request.security("IOT",   "D", close - close[1])
q_d    = request.security("Q",     "D", close - close[1])
rklb_d = request.security("RKLB",  "D", close - close[1])
gldm_d = request.security("GLDM",  "D", close - close[1])
voog_d = request.security("VOOG",  "D", close - close[1])
crcl_d = request.security("CRCL",  "D", close - close[1])
iren_d = request.security("IREN",  "D", close - close[1])
nbis_d = request.security("NBIS",  "D", close - close[1])
spcx_d = request.security("SPCX",  "D", close - close[1])
apld_d = request.security("APLD",  "D", close - close[1])
cnc_d  = request.security("CNC",   "D", close - close[1])
lscc_d = request.security("LSCC",  "D", close - close[1])

// DBG fully liquidated 2026-08-13 (100% cash) — no open DBG positions left.
dbg_day_pl  = 0.0

// MSFT + JPM both fully closed Aug-13 — dropped from ibkr_day_pl.
ibkr_day_pl = nz(rxt_d)  * 160  +
              nz(hpe_d)  * 10   +
              nz(glw_d)  * 9    +
              nz(mu_d)   * 1    +
              nz(ewy_d)  * 4.5  +
              nz(fps_d)  * 10   +
              nz(ichr_d) * 8    +
              nz(snex_d) * 9    +
              nz(dlth_d) * 100  +
              nz(lite_d) * 1    +
              nz(avgo_d) * 3    +
              nz(btsg_d) * 15   +
              nz(intc_d) * 3    +
              nz(iot_d)  * 10   +
              nz(q_d)    * 2    +
              nz(gldm_d) * 5    +
              nz(voog_d) * 5    +
              nz(iren_d) * 20   +
              nz(nbis_d) * 3    +
              nz(orcl_d) * 4    +
              nz(goog_d) * 1    +
              nz(rklb_d) * 7    +
              nz(spcx_d) * 2    +
              nz(apld_d) * 27   +
              nz(cnc_d)  * 7    +
              nz(lscc_d) * 2

total_day_pl = dbg_day_pl + ibkr_day_pl

_fmt(v) =>
    (v >= 0 ? "+$" : "-$") + str.tostring(math.abs(v), "#.0")
_clr(v) => v >= 0 ? color.green : color.red

// ── CUMULATIVE LIFETIME P&L (per ticker, realised + live unrealized) ──────────
// cum_realised includes dividends received ITD (income field), matches dashboard
// "Realized P&L (net, incl. div)" convention. MSFT/ORCL/SHIP have no closed
// cycles — their entry here is dividends only.
// cum_realised rebuilt 2026-08-14 from Doha Bank's full-lifetime closed-positions
// ledger (exact reconciliation to $2,193.92 DBG ITD realized P/L) — fixes latent
// drift in RKLB/MU/MUU/TOL/TTE/GOOG/COST that had accumulated from earlier
// session hand-entries, and adds the Aug-13 full-account-liquidation closes.
cum_realised = tk == "AAOI" ? 308.50 :
              tk == "AMZN" ? 7.28 :
              tk == "AVGO" ? 129.21 :
              tk == "BSET" ? -2.61 :
              tk == "COST" ? 140.30 :
              tk == "CRCL" ? 4.39 :
              tk == "DAX" ? -23.41 :
              tk == "DLTH" ? 51.67 :
              tk == "DOCN" ? 203.79 :
              tk == "EGHT" ? -42.29 :
              tk == "ELPC" ? -9.61 :
              tk == "EWY" ? 549.7 :
              tk == "GEV" ? 55.29 :
              tk == "GLW" ? 469.54 :
              tk == "GOOG" ? 119.69 :
              tk == "HUMN" ? -80.56 :
              tk == "ICHR" ? 40.73 :
              tk == "INOD" ? -81.71 :
              tk == "INTC" ? 189.73 :
              tk == "IRS" ? -25.29 :
              tk == "JDZG" ? -1657.26 :
              tk == "JPM" ? -1.27 :
              tk == "KEEL" ? 107.98 :
              tk == "META" ? -178.54 :
              tk == "MP" ? 15.88 :
              tk == "MSFT" ? 597.48 :
              tk == "MU" ? 997.81 :
              tk == "MUU" ? 95.21 :
              tk == "NVDA" ? 41.40 :
              tk == "NOW" ? 245.67 :
              tk == "ORCL" ? -302.58 :
              tk == "QBTS" ? 42.96 :
              tk == "RKLB" ? 318.09 :
              tk == "RXT" ? -219.65 :
              tk == "SHAZ" ? 23.33 :
              tk == "SHIP" ? 90.96 :
              tk == "SIVR" ? 133.11 :
              tk == "TOL" ? 22.14 :
              tk == "TTE" ? 29.42 :
              tk == "VOOG" ? 155.54 :
              0.0

cum_open_qty = tk == "AVGO" ? 3.0 :
               tk == "BTSG" ? 15.0 :
               tk == "CNC" ? 7.0 :
               tk == "LSCC" ? 2.0 :
               tk == "DLTH" ? 100.0 :
               tk == "EWY" ? 4.5 :
               tk == "FPS" ? 10.0 :
               tk == "GLDM" ? 5.0 :
               tk == "GLW" ? 9.0 :
               tk == "HPE" ? 10.0 :
               tk == "ICHR" ? 8.0 :
               tk == "INTC" ? 3.0 :
               tk == "IOT" ? 10.0 :
               tk == "LITE" ? 1.0 :
               tk == "MU" ? 1.0 :
               tk == "ORCL" ? 4.0 :
               tk == "Q" ? 2.0 :
               tk == "RXT" ? 160.0 :
               tk == "SNEX" ? 9.0 :
               tk == "VOOG" ? 5.0 :
               tk == "IREN" ? 20.0 :
               tk == "NBIS" ? 3.0 :
               tk == "GOOG" ? 1.0 :
               tk == "RKLB" ? 7.0 :
               tk == "SPCX" ? 2.0 :
               tk == "APLD" ? 27.0 :
               0.0

cum_open_avg = tk == "AVGO" ? 389.939833 :
               tk == "BTSG" ? 61.8198 :
               tk == "CNC" ? 65.062860 :
               tk == "LSCC" ? 130.280003 :
               tk == "DLTH" ? 4.200003 :
               tk == "EWY" ? 173.050067 :
               tk == "FPS" ? 44.92 :
               tk == "GLDM" ? 80.405 :
               tk == "GLW" ? 154.361667 :
               tk == "HPE" ? 44.54 :
               tk == "ICHR" ? 82.54625 :
               tk == "INTC" ? 102.953333 :
               tk == "IOT" ? 33.44 :
               tk == "LITE" ? 797.34 :
               tk == "MU" ? 931.0 :
               tk == "ORCL" ? 121.113 :
               tk == "Q" ? 138.59 :
               tk == "RXT" ? 4.616433 :
               tk == "SNEX" ? 78.075556 :
               tk == "VOOG" ? 80.2 :
               tk == "IREN" ? 37.950005 :
               tk == "NBIS" ? 198.143333 :
               tk == "GOOG" ? 367.33 :
               tk == "RKLB" ? 72.872857 :
               tk == "SPCX" ? 121.84 :
               tk == "APLD" ? 31.527040037 :
               0.0

cum_unreal = cum_open_qty > 0 ? (close - cum_open_avg) * cum_open_qty : 0.0
cum_pnl    = cum_realised + cum_unreal

pos_status = tk == "AMZN"  ? "CLOSED" :
             tk == "MSFT"  ? "CLOSED" :
             tk == "NVDA"  ? "CLOSED" :
             tk == "ORCL"  ? "OPEN"   :
             tk == "SHIP"  ? "CLOSED" :
             tk == "NOW"   ? "CLOSED" :
             tk == "QBTS"  ? "CLOSED" :
             tk == "RXT"   ? "OPEN"   :
             tk == "BTSG"  ? "OPEN"   :
             tk == "HPE"   ? "OPEN"   :
             tk == "GLW"   ? "OPEN"   :
             tk == "MU"    ? "OPEN"   :
             tk == "EWY"   ? "OPEN"   :
             tk == "FPS"   ? "OPEN"   :
             tk == "ICHR"  ? "OPEN"   :
             tk == "SNEX"  ? "OPEN"   :
             tk == "DLTH"  ? "OPEN"   :
             tk == "IOT"   ? "OPEN"   :
             tk == "LITE"  ? "OPEN"   :
             tk == "SHAZ"  ? "CLOSED" :
             tk == "Q"     ? "OPEN"   :
             tk == "AVGO"  ? "OPEN"   :
             tk == "VOOG"  ? "OPEN"   :
             tk == "GLDM"  ? "OPEN"   :
             tk == "AAOI"  ? "CLOSED" :
             tk == "CNC"   ? "OPEN"   :
             tk == "LSCC"  ? "OPEN"   :
             tk == "CRCL"  ? "CLOSED" :
             tk == "IREN"  ? "OPEN"   :
             tk == "NBIS"  ? "OPEN"   :
             tk == "GOOG"  ? "OPEN"   :
             tk == "RKLB"  ? "OPEN"   :
             tk == "JPM"   ? "CLOSED" :
             tk == "SPCX"  ? "OPEN"   :
             tk == "APLD"  ? "OPEN"   :
             tk == "GEV"   ? "CLOSED" :
             tk == "HUMN"  ? "CLOSED" :
             tk == "INTC"  ? "OPEN"   :
             tk == "MP"    ? "CLOSED" :
             tk == "ELPC"  ? "CLOSED" :
             tk == "BSET"  ? "CLOSED" :
             tk == "JDZG"  ? "CLOSED" :
             tk == "TTE"   ? "CLOSED" :
             tk == "COST"  ? "CLOSED" :
             tk == "DAX"   ? "CLOSED" :
             tk == "DOCN"  ? "CLOSED" :
             tk == "EGHT"  ? "CLOSED" :
             tk == "INOD"  ? "CLOSED" :
             tk == "IRS"   ? "CLOSED" :
             tk == "KEEL"  ? "CLOSED" :
             tk == "META"  ? "CLOSED" :
             tk == "MUU"   ? "CLOSED" :
             tk == "SIVR"  ? "CLOSED" :
             tk == "TOL"   ? "CLOSED" : ""

pos_clr = pos_status == "OPEN" ? color.lime : pos_status == "CLOSED" ? color.orange : color.gray
// DBG fully liquidated — only one broker (IBKR) left, so the DBG/IBKR/TOTAL
// split row is gone, collapsed into a single DAY P&L row.
pos_rows = pos_status == "OPEN" ? 4 : pos_status == "CLOSED" ? 3 : 1

if barstate.islast
    t = table.new(position.top_right, 2, pos_rows,
                  bgcolor=color.new(color.black, 60),
                  border_color=color.new(color.gray, 50), border_width=1,
                  frame_color=color.new(color.gray, 30), frame_width=1)
    table.cell(t, 0, 0, "DAY P&L", text_color=color.gray,        text_size=size.normal)
    table.cell(t, 1, 0, _fmt(total_day_pl), text_color=_clr(total_day_pl), text_size=size.normal, text_halign=text.align_right)

    if pos_status == "OPEN"
        // QTY + Avg together, one row — no longer printed on the chart labels
        table.cell(t, 0, 1, "AVG:$" + str.tostring(cum_open_avg, "#.00") + " (" + str.tostring(cum_open_qty, "#.##") + ")", text_color=color.white, text_size=size.normal, text_halign=text.align_left)
        table.cell(t, 1, 1, pos_status, text_color=pos_clr, text_size=size.normal, text_halign=text.align_right)
        table.cell(t, 0, 2, "CUM P&L", text_color=color.gray, text_size=size.normal)
        table.cell(t, 1, 2, _fmt(cum_pnl), text_color=_clr(cum_pnl), text_size=size.normal, text_halign=text.align_right)
        table.cell(t, 0, 3, "OPEN P&L", text_color=color.gray, text_size=size.normal)
        table.cell(t, 1, 3, _fmt(cum_unreal), text_color=_clr(cum_unreal), text_size=size.normal, text_halign=text.align_right)
    else if pos_status == "CLOSED"
        // Keep CLOSED status centered across both columns — no qty (position is gone)
        table.cell(t, 0, 1, pos_status, text_color=pos_clr, text_size=size.normal, text_halign=text.align_center)
        table.cell(t, 1, 1, "")
        table.merge_cells(t, 0, 1, 1, 1)
        table.cell(t, 0, 2, "CUM P&L", text_color=color.gray, text_size=size.normal)
        table.cell(t, 1, 2, _fmt(cum_pnl), text_color=_clr(cum_pnl), text_size=size.normal, text_halign=text.align_right)
